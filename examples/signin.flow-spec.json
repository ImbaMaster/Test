    { "id": "loggedA", "type": "success", "phase": "my-account", "hint": { "col": 9, "row": -1 }, "tag": "Result", "label": "Patient Logged" },
    { "id": "loggedB", "type": "success", "phase": "my-account", "tag": "Result", "label": "Patient Logged" },
    { "id": "mgmtLoaded", "type": "end", "phase": "my-account", "label": "Account Management with Loaded Data" },
    { "id": "mgmtEmpty", "type": "end", "phase": "my-account", "label": "Account Management with Empty Data" }
